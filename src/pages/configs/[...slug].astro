---
import { render } from 'astro:content';
import Entry from '../../layouts/Entry.astro';
import { getConfigs } from '../../lib/content';

export async function getStaticPaths() {
  return (await getConfigs()).map((config) => ({ params: { slug: config.id }, props: { config } }));
}

const { config } = Astro.props;
const { Content } = await render(config);
const { title, description, date, updated, tags, category } = config.data;
---

<Entry {title} {description} date={updated ?? date} {tags} back={{ href: '/configs', label: 'Configs' }}>
  <span slot="meta" class="meta">· {category}</span>
  <Content />
</Entry>
