---
import Base from '../layouts/Base.astro';
import { SITE, SOCIALS } from '../consts';
import { getNav } from '../lib/content';

const sections = await getNav();
---

<Base>
  <section class="hero container">
    <!-- Brand motif: the logo's exponential crossbar, drawn at scale. -->
    <svg class="curve" viewBox="0 0 1000 600" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 560 C 420 560, 700 520, 860 330 S 960 60, 990 0" />
    </svg>

    <h1>Enzo M<span class="dot">.</span></h1>
    <p class="tagline">{SITE.tagline}</p>

    <nav class="sections" aria-label="Sections">
      {sections.map((s) => (
        <a href={s.href}>
          <span>{s.label}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
        </a>
      ))}
    </nav>

    <ul class="socials">
      {SOCIALS.map((s) => <li><a href={s.href}>{s.label}<span aria-hidden="true">↗</span></a></li>)}
    </ul>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: calc(100dvh - 12rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 3rem 4rem;
  }
  .curve {
    position: absolute;
    inset: 6% var(--gutter) 4% 34%;
    width: auto; height: auto;
    z-index: -1;
    overflow: visible;
  }
  .curve path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    opacity: .9;
    stroke-dasharray: 1600;
    stroke-dashoffset: 1600;
    animation: draw 1.8s cubic-bezier(.6, 0, .2, 1) .2s forwards;
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .curve path { animation: none; stroke-dashoffset: 0; } }

  h1 {
    font-size: clamp(4rem, 15vw, 9rem);
    line-height: .9;
    letter-spacing: -0.055em;
    margin: 0;
  }
  .tagline {
    font-size: clamp(1.2rem, 2.6vw, 1.6rem);
    font-style: italic;
    color: var(--muted);
    margin: 1.25rem 0 3rem;
    max-width: 26ch;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .sections { display: flex; flex-direction: column; align-items: flex-start; gap: .1rem; margin-bottom: 3rem; }
  .sections a {
    display: inline-flex;
    align-items: center;
    gap: .75rem;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.3;
    text-decoration: none;
  }
  .sections svg {
    width: .8em; height: .8em;
    fill: none; stroke: var(--accent); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round;
    opacity: 0; transform: translateX(-.5em);
    transition: opacity .2s, transform .2s;
  }
  .sections a:hover svg, .sections a:focus-visible svg { opacity: 1; transform: none; }

  .socials { list-style: none; display: flex; flex-wrap: wrap; gap: .75rem; padding: 0; margin: 0; }
  .socials a {
    display: inline-flex; align-items: center; gap: .4rem;
    font-family: var(--font-mono);
    font-size: .875rem;
    text-decoration: none;
    padding: .45rem 1rem;
    border: 1px solid var(--border);
    border-radius: 99px;
    background: var(--bg);
    transition: border-color .15s, color .15s, background .15s;
  }
  .socials a:hover { border-color: var(--accent); background: var(--accent-soft); }
  .socials span { color: var(--accent); }

  @media (max-width: 640px) { .curve { inset: 40% var(--gutter) 30% 10%; opacity: .5; } }
  @media (hover: none) { .sections svg { opacity: 1; transform: none; } }
</style>
